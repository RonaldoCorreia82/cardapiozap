# Supabase — encontre em: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# URL pública do seu site (sem barra no final)
NEXT_PUBLIC_APP_URL=https://seudominio.com.br

# WhatsApp de contato para o botão da landing page (só números com DDI)
NEXT_PUBLIC_WHATSAPP_CONTATO=5575981806299

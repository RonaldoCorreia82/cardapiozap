# ============================================================
# CardápioZap — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no git
# ============================================================

# ---- Supabase ----
# Encontre em: painel Supabase > Settings > API

# URL do seu projeto Supabase (pública, pode estar no frontend)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave anônima do Supabase (pública, pode estar no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Chave de serviço do Supabase (SECRETA — apenas no servidor)
# Usada pelo Server Action para inserir pedidos sem autenticação do cliente
# Encontre em: Supabase > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ---- Administrador geral (master) ----
# E-mail do administrador geral do CardápioZap (você, o fundador)
# Quem logar com este e-mail será redirecionado para /master
# e terá acesso a todos os restaurantes
MASTER_EMAIL=seu@email.com

# ---- Aplicação ----
# URL pública da aplicação (sem barra no final)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-dominio.vercel.app ou domínio customizado
NEXT_PUBLIC_APP_URL=http://localhost:3000
